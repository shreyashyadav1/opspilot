# Copy to .env (gitignored) and fill in what you need. Never commit real keys.

# Default model: Groq openai/gpt-oss-120b (OpenAI-compatible endpoint).
GROQ_API_KEY=

# Pick another model with provider:model, e.g. openai:gpt-4o-mini or ollama:llama3.1
# OPSPILOT_MODEL=groq:openai/gpt-oss-120b
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Any other OpenAI-compatible server (provider "custom"):
# OPSPILOT_LLM_BASE_URL=http://localhost:8000/v1
# OPSPILOT_LLM_API_KEY=

# Where the MCP server finds the demo system (defaults shown).
# OPSPILOT_PROMETHEUS_URL=http://localhost:9095
# OPSPILOT_CONTROL_PLANE_URL=http://localhost:8190
# OPSPILOT_SERVICE_URLS=storefront=http://localhost:8101,orders=http://localhost:8102,payments=http://localhost:8103

# Agent API (make api-dev and the docker compose dashboard profile set these for you).
# OPSPILOT_CHAOS_URL=http://localhost:8190    # enables the dashboard's demo fault panel
# OPSPILOT_API_DATA_DIR=.opspilot             # investigation records and graph checkpoints
# OPSPILOT_MAX_CONCURRENT=2                   # investigations that run at the same time
# OPSPILOT_MAX_RESUMES=1                      # resumes of a run cut off by a restart (0 = mark failed)
# API keys with roles (viewer, operator, approver). Unset, the API runs open for the local demo.
# Create entries with: .venv/bin/python -m opspilot_api.keys new <name> <role>
# OPSPILOT_API_KEYS=alice:approver:<sha256>,olly:operator:<sha256>

# Tracing (OpenTelemetry), off by default. When on, the agent, the API, the MCP server and every
# demo service export spans over OTLP/HTTP; `make up-tracing` or `make dashboard-up` start a
# Jaeger UI on http://localhost:8166. docker compose points the containers at Jaeger itself;
# set the endpoint only for runs on the host (the default is shown).
# OPSPILOT_TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# USD-per-million-token prices used to estimate each investigation's cost (default shown). A
# model missing from the file is reported with an unknown cost, never a guessed one.
# OPSPILOT_PRICING_FILE=evals/pricing.yaml
